@page "/api-test"
@inject ICertificateService CertificateService
@inject ILogger<ApiTest> Logger
@using System.Text.Json

<PageTitle>API Test</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h1 class="h4 mb-0">API Connection Test</h1>
        </div>
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 mb-0">Testing API connection...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <h4 class="alert-heading">Error connecting to API</h4>
                    <p class="mb-0">@errorMessage</p>
                </div>
            }
            else if (apiResponse != null)
            {
                <div class="alert alert-success">
                    <h4 class="alert-heading">API Connection Successful!</h4>
                    <div class="mt-3">
                        <div class="card bg-light">
                            <div class="card-body p-2">
                                <pre class="mb-0">@FormatJson(apiResponse)</pre>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="TestApiConnection" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise me-1"></i> @(isLoading ? "Testing..." : "Test Connection")
                </button>
            </div>
        </div>
        <div class="card-footer text-muted">
            <small>Last tested: @lastTested?.ToString("yyyy-MM-dd HH:mm:ss")</small>
        </div>
    </div>
</div>

@code {
    private bool isLoading = false;
    private string? errorMessage;
    private string? apiResponse;
    private DateTime? lastTested;

    protected override async Task OnInitializedAsync()
    {
        await TestApiConnection();
    }

    private string FormatJson(string jsonString)
    {
        try
        {
            using var doc = JsonDocument.Parse(jsonString);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions 
            { 
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch
        {
            return jsonString;
        }
    }

    private async Task TestApiConnection()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            apiResponse = await CertificateService.GetTestMessageAsync();
            lastTested = DateTime.Now;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            apiResponse = null;
            Logger.LogError(ex, "Error testing API connection");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
