@page "/certificates"
@using CertificateManager.Shared.Models
@using Microsoft.Extensions.Logging
@inject ICertificateService CertificateService
@inject ILogger<CertificateList> Logger

<PageTitle>Certificates</PageTitle>

<h1>Certificates</h1>

@if (certificates == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="ms-2">Loading certificates...</span>
    </div>
}
else if (loadFailed)
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Error loading certificates</h4>
        <p>Failed to load certificates. Please try again later.</p>
        <button class="btn btn-primary btn-sm" @onclick="LoadCertificates">
            <i class="bi bi-arrow-clockwise"></i> Retry
        </button>
    </div>
}
else if (!certificates.Any())
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i> No certificates found.
    </div>
}
else
{
    <table class="table table-striped">
        <thead class="thead-light">
            <tr>
                <th>Name</th>
                <th>Subject</th>
                <th>Issuer</th>
                <th>Serial Number</th>
                <th>Valid From</th>
                <th>Valid To</th>
                <th>Thumbprint</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cert in certificates)
            {
                <tr>
                    <td>@cert.Name</td>
                    <td>@cert.Subject</td>
                    <td>@cert.Issuer</td>
                    <td>@cert.SerialNumber</td>
                    <td>@cert.ValidFrom.ToShortDateString()</td>
                    <td>@cert.ValidTo.ToShortDateString()</td>
                    <td>@cert.Thumbprint</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Certificate>? certificates;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        await LoadCertificates();
    }

    private async Task LoadCertificates()
    {
        try
        {
            loadFailed = false;
            certificates = null;
            await InvokeAsync(StateHasChanged);

            var result = await CertificateService.GetAllCertificatesAsync();
            certificates = result ?? new List<Certificate>();
            
            if (loadFailed) // If previous attempt failed but this one succeeded
            {
                loadFailed = false;
            }
        }
        catch (Exception ex)
        {
            loadFailed = true;
            Logger.LogError(ex, "Error loading certificates");
            certificates = new List<Certificate>(); // Ensure we have an empty list even on error
            certificates = new List<Certificate>(); // Ensure certificates is not null for the UI
        }
    }
}
